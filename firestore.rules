rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function role() {
      return userDoc().role;
    }

    function isSuperAdmin() {
      return isAuth() && role() == 'superAdmin';
    }

    function isAdmin() {
      return isAuth() && (role() == 'admin' || role() == 'superAdmin');
    }

    // Any admin-tier role that can access the admin panel
    function isAdminTier() {
      return isAuth() && role() in [
        'admin', 'superAdmin', 'operationsManager',
        'supportAgent', 'finance', 'contentManager',
        'moderator', 'staff'
      ];
    }

    // Checks a named permission for the current user.
    // superAdmin always passes; for all other admin-tier roles we check
    // customPermissions (explicit deny wins over role default).
    // This mirrors the Flutter PermissionService.can() two-layer logic but
    // only covers the permissions we can enumerate in rules without duplicating
    // the full matrix. Role-default grants are enforced by the role checks below.
    function hasPerm(permName) {
      let custom = userDoc().get('customPermissions', {});
      // Explicit deny always blocks.
      return !(custom.get(permName, true) == false);
    }

    // Convenience wrappers for the most sensitive write operations.
    function canSuspendUser() {
      return isSuperAdmin() ||
        (isAdminTier() && hasPerm('suspendUser'));
    }

    function canChangeRole() {
      return isSuperAdmin() ||
        (isAdmin() && hasPerm('changeUserRole'));
    }

    function canManageSettings() {
      return isSuperAdmin() ||
        (isAdmin() && hasPerm('manageSettings'));
    }

    function canApproveArena() {
      return isSuperAdmin() ||
        (isAdminTier() && hasPerm('approveArena'));
    }

    function canViewFinancials() {
      return isSuperAdmin() ||
        (isAdminTier() && hasPerm('viewFinancials'));
    }

    function isOwner() {
      return isAuth() && role() == 'owner';
    }

    // True only when the signed-in user is the owner of the specific arena.
    // Uses a get() to verify ownership — safe because each request chain is
    // independent and Firestore caches the read within the evaluation.
    function ownsArena(arenaId) {
      return isOwner() &&
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.ownerId == uid();
    }

    function isStaff() {
      return isAuth() && role() in ['staff', 'supportAgent', 'admin', 'superAdmin', 'operationsManager', 'moderator'];
    }

    function isActive() {
      return userDoc().isActive == true;
    }

    // Check that the user's account is active before allowing any write
    function isActiveAuth() {
      return isAuth() && isActive();
    }

    // ── Users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && (
        uid() == userId ||
        isAdminTier() ||
        isOwner()
      );
      allow create: if isAuth() && uid() == userId;
      // Users may update their own profile but NEVER elevate their role
      // or toggle isActive — those fields are admin-only.
      allow update: if isAuth() && (
        (uid() == userId &&
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role', 'isActive', 'accountStatus',
              'customPermissions', 'managedArenaIds', 'managedOwnerIds']))
        || (canChangeRole() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'customPermissions', 'managedArenaIds', 'managedOwnerIds']))
        || (canSuspendUser() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['accountStatus', 'isActive']))
        || isAdmin()
      );
      allow delete: if isSuperAdmin();

      match /favorites/{arenaId} {
        allow read, write: if isAuth() && uid() == userId;
      }
    }

    // ── Helpers: arena staff permission checks ────────────────────────
    // Any staff member assigned to the arena has full management access.
    // Granular per-arena permissions (arenaPermissions map) are no longer
    // required — assignment implies full access for that arena.
    function isArenaStaff(arenaId) {
      return isAuth() &&
        userDoc().role == 'staff' &&
        userDoc().get('ownerId', null) != null &&
        userDoc().get('assignedArenas', []).hasAny([arenaId]);
    }

    function staffCanEditArena(arenaId) {
      return isArenaStaff(arenaId);
    }

    function staffCanEditCourts(arenaId) {
      return isArenaStaff(arenaId);
    }

    // For chats: staff can access a chat if their assigned arenas include the
    // chat's arenaId.  Used in chat read/write rules.
    function staffCanAccessChat(chatData) {
      return isAuth() &&
        userDoc().role == 'staff' &&
        userDoc().get('ownerId', null) != null &&
        chatData.get('arenaId', null) != null &&
        userDoc().get('assignedArenas', []).hasAny([chatData.arenaId]);
    }

    // ── Arenas ────────────────────────────────────────────────────────
    match /arenas/{arenaId} {
      allow read: if isAuth();
      // Only owners and admin-tier can create arenas.
      allow create: if isActiveAuth() && (isOwner() || isAdminTier());
      allow update: if isActiveAuth() && (
        resource.data.ownerId == uid() ||
        isAdminTier() ||
        staffCanEditArena(arenaId)
      );
      allow delete: if isAdmin();

      match /courts/{courtId} {
        allow read: if isAuth();
        allow write: if isActiveAuth() && (
          get(/databases/$(database)/documents/arenas/$(arenaId)).data.ownerId == uid() ||
          isAdminTier() ||
          staffCanEditCourts(arenaId)
        );
      }

      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isActiveAuth() && request.resource.data.customerId == uid();
        allow update, delete: if false;
      }
    }

    // ── Bookings ──────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Scoped: customers see their own, owners see their own, admin-tier
      // (which includes 'staff' role) can read all for operational access.
      // This closes the previous allow read: if isAuth() which leaked all
      // booking PII (names, phones, payment details) to every auth'd user.
      allow read: if isAuth() && (
        resource.data.customerId == uid() ||
        resource.data.ownerId == uid() ||
        isAdminTier()
      );
      // Suspended users (isActive=false) cannot create bookings
      allow create: if isActiveAuth() && isActive();
      allow update: if isAuth() && (
        resource.data.ownerId == uid() ||
        isStaff() ||
        // Customers may update only non-financial, non-operational fields
        // (e.g. cancel request, reschedule request). They must never touch
        // amountPaid / totalAmount / checkedIn / status-machine fields.
        (resource.data.customerId == uid() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'amountPaid', 'totalAmount', 'remainingAmount', 'totalAmountStored',
            'checkedIn', 'checkedInAt', 'completedAt', 'ownerId', 'courtId',
            'arenaId', 'isPosBooking', 'posPaymentMethod', 'posDiscount',
            'posAddOnIds', 'posAddOnsTotal', 'bookedByRole'
          ]))
      );
      allow delete: if isAdmin();
    }

    // ── Chats ─────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && (
        uid() in resource.data.participants ||
        isAdmin() ||
        staffCanAccessChat(resource.data)
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        staffCanAccessChat(resource.data) ||
        (uid() in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'activeBookingId', 'unreadCounts', 'lastMessage',
            'lastMessageAt', 'pairKey', 'arenaId', 'customerId'
          ]))
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuth() && (
          uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          isAdmin() ||
          staffCanAccessChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
        );
        allow create: if isAuth() &&
          request.resource.data.senderId == uid() &&
          request.resource.data.type != 'system' &&
          (
            uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
            isAdmin() ||
            staffCanAccessChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow update, delete: if false;
      }
    }

    // ── Tickets ───────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isAuth() && (
        resource.data.raisedByUid == uid() || isAdminTier()
      );
      allow create: if isActiveAuth();
      allow update: if isAuth() && (
        isAdminTier() || resource.data.raisedByUid == uid()
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.raisedByUid == uid()
          || isAdminTier()
        );
        allow create: if isAuth() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.raisedByUid == uid()
          || isAdminTier()
        );
        allow update, delete: if isAdmin();
      }
    }

    // ── Tournaments ───────────────────────────────────────────────────
    match /tournaments/{tId} {
      allow read: if isAuth();
      allow create: if isActiveAuth() && (isOwner() || isAdminTier());
      allow update: if isAuth() && (
        resource.data.createdBy == uid() || isAdminTier()
      );
      allow delete: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        isOwner() ||
        isAdminTier()
      );
      allow create: if isActiveAuth();
      allow update: if isAuth() && (isOwner() || isAdminTier());
      allow delete: if isAdmin();
    }

    match /brackets/{tId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isOwner() || isAdminTier());
    }

    // ── Boost requests ────────────────────────────────────────────────
    match /boostRequests/{reqId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() || isAdminTier()
      );
      allow create: if isActiveAuth() && isOwner();
      allow update: if isAdminTier();
      allow delete: if isAdmin();
    }

    // ── Settings (admin-managed config) ───────────────────────────────
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if canManageSettings();
    }

    // ── Waitlist ──────────────────────────────────────────────────────
    match /waitlist/{entryId} {
      allow read: if isAuth() && (resource.data.customerId == uid() || isStaff());
      allow create: if isActiveAuth() && request.resource.data.customerId == uid();
      allow delete: if isAuth() && resource.data.customerId == uid();
      allow update: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.uid == uid();
      allow update: if isAuth() && resource.data.uid == uid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuth() && resource.data.uid == uid();
      allow create: if false; // server-side only (Cloud Functions Admin SDK)
    }

    // ── Blocked slots ─────────────────────────────────────────────────
    match /blockedSlots/{slotId} {
      allow read: if isAuth();
      allow create: if isActiveAuth() && (
        request.resource.data.ownerId == uid() ||
        isArenaStaff(request.resource.data.arenaId)
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == uid() ||
        isArenaStaff(resource.data.arenaId)
      );
      allow update: if false;
    }

    // ── OTP rate-limit counters ───────────────────────────────────────
    match /_otpRateLimits/{email} {
      allow read, write: if false; // Cloud Functions only
    }

    // ── Audit logs — immutable, admin-tier read, admin-tier write ─────
    // Clients write logs (the audit service runs as the signed-in user).
    // Logs can never be updated or deleted — append-only by design.
    match /audit_logs/{logId} {
      allow read: if isAdminTier();
      allow create: if isAdminTier();
      allow update, delete: if false; // immutable
    }

    // ── Staff invitations ─────────────────────────────────────────────
    // Owners manage invitations for their own staff.
    // The invited staff can read their own invitation.
    // All writes go through the staffManagement Cloud Function (Admin SDK).
    match /staffInvitations/{invId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() ||
        resource.data.targetUid == uid() ||
        isAdmin()
      );
      allow create, update, delete: if false; // CF only
    }

    // ── Staff permission requests ─────────────────────────────────────
    // Staff create; owner reads + Cloud Function resolves.
    match /staffPermissionRequests/{reqId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() ||
        resource.data.staffUid == uid() ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.staffUid == uid();
      allow update, delete: if false; // CF only
    }

    // ── Owner invitations ─────────────────────────────────────────────
    // Admins manage all invitations.
    // The invited owner can read their own invitation (to check status in-app).
    // No client writes — all mutations go through the inviteOwner Cloud Function
    // (Admin SDK bypasses these rules, so CF writes always succeed).
    match /ownerInvitations/{invitationId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.targetUid == uid());
      allow create, update, delete: if isAdmin();
    }

    match /adminInvitations/{invitationId} {
      // Only admin-tier users can see admin invitations; invitee can read their own.
      allow read: if isAdminTier() ||
        (isAuth() && resource.data.targetUid == uid());
      // Only admins (and Cloud Functions acting as admin) can write.
      allow create, update, delete: if isAdmin();
    }

    // ── Legacy auditLogs collection (kept for backward compat) ────────
    match /auditLogs/{logId} {
      allow read: if isAdminTier();
      allow create: if isAdminTier();
      allow update, delete: if false;
    }

    // ── Payouts — admin writes, admin reads, never customer/owner ────────
    match /payouts/{payoutId} {
      allow read: if isAdminTier() || (isOwner() && resource.data.ownerId == uid());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // immutable history
    }

    // ── Finance stats (aggregated) ────────────────────────────────────────
    match /finance/{docId} {
      allow read: if isAdminTier();
      allow write: if isAdmin();
    }

    // ── POS collections ───────────────────────────────────────────────
    // All POS reads/writes are now scoped to the arena that owns the record.
    // ownsArena() verifies the user is the owner of that specific arena.
    // isArenaStaff() verifies the user is staff assigned to that specific arena.
    // isAdminTier() covers platform admin read-only access.

    match /posTransactions/{txnId} {
      allow read: if isAuth() && (
        ownsArena(resource.data.arenaId) ||
        isArenaStaff(resource.data.arenaId) ||
        isAdminTier()
      );
      allow create: if isActiveAuth() && (
        ownsArena(request.resource.data.arenaId) ||
        isArenaStaff(request.resource.data.arenaId)
      );
      allow update: if isActiveAuth() && ownsArena(resource.data.arenaId);
      allow delete: if false;
    }

    match /posExpenses/{expId} {
      allow read: if isAuth() && (
        ownsArena(resource.data.arenaId) ||
        isArenaStaff(resource.data.arenaId) ||
        isAdminTier()
      );
      allow create: if isActiveAuth() && (
        ownsArena(request.resource.data.arenaId) ||
        isArenaStaff(request.resource.data.arenaId)
      );
      allow update: if isActiveAuth() && ownsArena(resource.data.arenaId);
      allow delete: if isActiveAuth() && ownsArena(resource.data.arenaId);
    }

    match /posShifts/{shiftId} {
      allow read: if isAuth() && (
        ownsArena(resource.data.arenaId) ||
        isArenaStaff(resource.data.arenaId) ||
        isAdminTier()
      );
      allow create: if isActiveAuth() && (
        ownsArena(request.resource.data.arenaId) ||
        isArenaStaff(request.resource.data.arenaId)
      );
      // Staff can update shifts they opened; owners can update any shift.
      allow update: if isActiveAuth() && (
        ownsArena(resource.data.arenaId) ||
        (isArenaStaff(resource.data.arenaId) && resource.data.staffId == uid())
      );
      allow delete: if false;
    }

    match /arenas/{arenaId}/posProducts/{productId} {
      allow read: if isAuth() && (
        ownsArena(arenaId) || isArenaStaff(arenaId) || isAdminTier()
      );
      allow create, update, delete: if isActiveAuth() && (
        ownsArena(arenaId) || isArenaStaff(arenaId)
      );
    }

    // ── Extension requests ────────────────────────────────────────────
    // Customer creates (status must be 'pending') and can cancel their own.
    // Owner/staff can approve or reject (full update; transaction enforces logic).
    // No deletes.
    match /extensionRequests/{reqId} {
      allow read: if isAuth() && (
        resource.data.customerId == uid() ||
        resource.data.ownerId == uid() ||
        isArenaStaff(resource.data.arenaId) ||
        isAdminTier()
      );
      allow create: if isActiveAuth() &&
        request.resource.data.customerId == uid() &&
        request.resource.data.status == 'pending';
      // Customer may only cancel their own pending request.
      allow update: if isAuth() && (
        (resource.data.customerId == uid() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']) &&
          request.resource.data.status == 'cancelled') ||
        resource.data.ownerId == uid() ||
        isArenaStaff(resource.data.arenaId)
      );
      allow delete: if false;
    }

    // ── Slot locks ────────────────────────────────────────────────────
    match /slotLocks/{lockId} {
      allow read: if isAuth();
      // Creator must be the customer named in the lock (customer booking flow),
      // OR an owner/staff of that arena (manual/POS booking flow).
      // This prevents malicious users from creating fake locks to block slots.
      allow create: if isActiveAuth()
        && request.resource.data.keys().hasAll(['bookingId', 'courtId', 'arenaId', 'date'])
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && (
          request.resource.data.get('customerId', '') == uid() ||
          ownsArena(request.resource.data.arenaId) ||
          isArenaStaff(request.resource.data.arenaId)
        );
      allow delete: if isAuth() && (
        resource.data.get('customerId', '') == uid() ||
        ownsArena(resource.data.arenaId) ||
        isArenaStaff(resource.data.arenaId)
      );
      allow update: if false;
    }

    // ── Recurring booking series ──────────────────────────────────────────
    // One document per recurring series. Individual occurrences live in
    // bookings/{bookingId} and reference this via recurringGroupId.
    // Customers own their own series; owners can read series for their arenas;
    // admin-tier has full read access.
    match /recurringBookingSeries/{seriesId} {
      // Allow get on non-existent doc (resource == null) so idempotency checks
      // don't fail with permission-denied when the series doc was never created.
      allow get: if isAuth() && (
        resource == null ||
        resource.data.customerId == uid() ||
        resource.data.ownerId == uid() ||
        isAdminTier() ||
        isArenaStaff(resource.data.arenaId)
      );
      allow list: if isAuth() && (
        resource.data.customerId == uid() ||
        resource.data.ownerId == uid() ||
        isAdminTier() ||
        isArenaStaff(resource.data.arenaId)
      );
      // Customers create series documents as part of the booking flow.
      allow create: if isActiveAuth() && (
        // Customer creates the series doc during booking flow.
        request.resource.data.customerId == uid() &&
        request.resource.data.keys().hasAll([
          'customerId', 'arenaId', 'courtId', 'ownerId',
          'startDate', 'endDate', 'totalOccurrences', 'status'
        ]) ||
        // Owner/staff may upsert a minimal series doc when approving/rejecting
        // legacy bookings that predate the series collection.
        request.resource.data.ownerId == uid() ||
        isArenaStaff(request.resource.data.arenaId) ||
        isAdminTier()
      );
      // Status and confirmedCount are updated by owner approval and customer cancel.
      // Financial fields (totalAmount, etc.) are never on the series doc.
      allow update: if isAuth() && (
        resource.data.ownerId == uid() ||
        isArenaStaff(resource.data.arenaId) ||
        isAdminTier() ||
        // Customer may only cancel (set status to 'cancelled').
        (resource.data.customerId == uid() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'cancelledBy']))
      );
      allow delete: if isAdmin();
    }

    // ── Promotions ────────────────────────────────────────────────────────
    match /promotions/{promoId} {
      // All authenticated users may read promotions.
      // The query in PromotionService always filters by status == 'active',
      // so inactive/paused promos are never returned to customers in practice.
      // Restricting by resource.data.status here would block entire streams
      // when any doc in the result set is non-active.
      allow read: if isAuth();

      // Platform-scope promos: admin/superAdmin only.
      // Arena-scope promos: owner of that arena only.
      allow create: if isAuth() && (
        (request.resource.data.scope == 'platform' && isAdminTier()) ||
        (request.resource.data.scope == 'arena'
          && ownsArena(request.resource.data.arenaId)
          && request.resource.data.ownerId == uid()
          && request.resource.data.keys().hasAll(['arenaId', 'ownerId', 'title', 'code', 'codeNormalized', 'discountType', 'discountValue']))
      );

      allow update: if isAuth() && (
        // Admin can update platform promos.
        (resource.data.scope == 'platform' && isAdminTier()) ||
        // Owners can update their own arena promos.
        (resource.data.scope == 'arena' && ownsArena(resource.data.arenaId)) ||
        // Any authenticated user can increment usageCount (promo applied at booking).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
      );

      allow delete: if isAuth() && (
        (resource.data.scope == 'platform' && isAdminTier()) ||
        (resource.data.scope == 'arena' && ownsArena(resource.data.arenaId))
      );
    }
  }
}
